{
  "openapi": "3.0.3",
  "info": {
    "title": "Betting Platform API",
    "version": "1.0.0",
    "description": "Starter OpenAPI spec for a betting platform (auth, wallet, games, admin, payments, KYC, bonuses, notifications, support)."
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Production"
    },
    {
      "url": "https://staging.api.example.com/v1",
      "description": "Staging"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "integer"
          }
        },
        "example": {
          "message": "Unauthorized",
          "code": 401
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "email",
          "username"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Balance": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "total": {
            "type": "number",
            "format": "double"
          },
          "available": {
            "type": "number",
            "format": "double"
          },
          "locked": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "deposit",
              "withdrawal",
              "bet",
              "payout",
              "admin_credit",
              "admin_debit"
            ]
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Bet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "game": {
            "type": "string",
            "example": "crash"
          },
          "stake": {
            "type": "number",
            "format": "double"
          },
          "payoutMultiplier": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "won",
              "lost",
              "cashed_out",
              "cancelled"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GameRound": {
        "type": "object",
        "properties": {
          "roundId": {
            "type": "string"
          },
          "game": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "betting_closed",
              "running",
              "finished"
            ]
          },
          "metadata": {
            "type": "object"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DepositRequest": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "WithdrawRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "destination": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      },
      "KYCSubmission": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Bonus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "freebet",
              "deposit_match",
              "cashback"
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "AdminStats": {
        "type": "object",
        "properties": {
          "activeUsers": {
            "type": "integer"
          },
          "totalDeposits": {
            "type": "number",
            "format": "double"
          },
          "totalWithdrawals": {
            "type": "number",
            "format": "double"
          },
          "ggr": {
            "type": "number",
            "format": "double"
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register user",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auth tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh-token": {
      "post": {
        "summary": "Refresh access token",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid/expired refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/user/profile": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get user profile",
        "tags": [
          "User"
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Update user profile",
        "tags": [
          "User"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/user/balance": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get user balance",
        "tags": [
          "Wallet"
        ],
        "responses": {
          "200": {
            "description": "Balance object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            }
          }
        }
      }
    },
    "/wallet/deposit/request": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create deposit order",
        "tags": [
          "Wallet",
          "Payment"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepositRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Deposit initiated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "depositId": {
                      "type": "string"
                    },
                    "paymentUrl": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/payment/webhook": {
      "post": {
        "summary": "Payment gateway webhook (public)",
        "tags": [
          "Payment"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/wallet/withdraw/request": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Request withdrawal",
        "tags": [
          "Wallet"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WithdrawRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Withdrawal created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transaction"
                }
              }
            }
          }
        }
      }
    },
    "/wallet/ledger": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get wallet transaction ledger (paginated)",
        "tags": [
          "Wallet"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ledger",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Transaction"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/crash/round": {
      "get": {
        "summary": "Get current crash round",
        "tags": [
          "Game - Crash"
        ],
        "responses": {
          "200": {
            "description": "Current round",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameRound"
                }
              }
            }
          }
        }
      }
    },
    "/crash/bet": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Place crash bet",
        "tags": [
          "Game - Crash"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "stake": {
                    "type": "number",
                    "format": "double"
                  },
                  "autoCashout": {
                    "type": "number",
                    "format": "double",
                    "description": "Multiplier at which to auto-cashout (optional)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bet placed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bet"
                }
              }
            }
          },
          "400": {
            "description": "Betting closed / invalid stake"
          }
        }
      }
    },
    "/crash/cashout": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Cash out crash bet",
        "tags": [
          "Game - Crash"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "betId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cashed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bet"
                }
              }
            }
          }
        }
      }
    },
    "/crash/history": {
      "get": {
        "summary": "Crash rounds history",
        "tags": [
          "Game - Crash"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "History",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GameRound"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/roulette/current-round": {
      "get": {
        "summary": "Get current roulette round",
        "tags": [
          "Game - Roulette"
        ],
        "responses": {
          "200": {
            "description": "Current roulette round",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameRound"
                }
              }
            }
          }
        }
      }
    },
    "/roulette/bet": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Place roulette bet",
        "tags": [
          "Game - Roulette"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "example": "straight,red,black,odd,even"
                        },
                        "amount": {
                          "type": "number",
                          "format": "double"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bet(s) placed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Bet"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sports/events/live": {
      "get": {
        "summary": "Live sports events (stub)",
        "tags": [
          "Sports"
        ],
        "responses": {
          "200": {
            "description": "List of live events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/login": {
      "post": {
        "summary": "Admin login",
        "tags": [
          "Admin"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admin token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/stats/overview": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Admin stats overview",
        "tags": [
          "Admin"
        ],
        "responses": {
          "200": {
            "description": "Stats",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminStats"
                }
              }
            }
          }
        }
      }
    },
    "/admin/users": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List users (admin)",
        "tags": [
          "Admin"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/game/{game}/pause": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Pause a game (admin)",
        "tags": [
          "Admin",
          "Game"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "game",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paused"
          }
        }
      }
    },
    "/admin/wallet/credit": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Credit user wallet (admin)",
        "tags": [
          "Admin",
          "Wallet"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number",
                    "format": "double"
                  },
                  "reason": {
