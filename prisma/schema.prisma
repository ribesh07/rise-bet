generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  BET
  WIN
  BONUS
}

enum BetStatus {
  PENDING
  WON
  LOST
  CANCELLED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
  MODERATOR
}

enum Currency {
  INR
  TRX
  XRP
  USDT
  USDC
  SOL
  BNB
  ETH
  LTC
  BTC
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  password     String
  name         String?
  username     String    @unique
  phone        String?   @unique
  dob          String?
  referral     String?   @unique
  role         UserRole  @default(USER)
  isEmailVerified Boolean @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLogin    DateTime?

  wallets      Wallet[]  
  transactions Transaction[]
  bets         Bet[]
}



model Wallet {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  currency  Currency   
  image   String?   // store image URL for the currency
  balance   Decimal    @default(0.00) @db.Decimal(20, 12)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  @@unique([userId, currency]) 
}


model Admin {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  username        String?
  role        UserRole    @default(ADMIN)
  isActive    Boolean      @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  logs        ControlLog[]
}

model ControlLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String
  details   String?
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id])
}

model BetControl {
  id           Int       @id @default(autoincrement())
  mode         String?   // example: "AUTO" | "FORCE"
  forcedResult String?   // e.g. "WIN" | "LOSE" or null
  winRatio     Float?    // e.g. 0.8
  targetUserId Int?      // if applicable
  targetUserName   String?    
  active       Boolean   @default(true)
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())
}

model Transaction {
  id        Int             @id @default(autoincrement())
  userId    Int
  type      TransactionType
  currency  Currency
  amount    Decimal          @default(0.00) @db.Decimal(12,2)
  createdAt DateTime         @default(now())
  status    TransactionStatus @default(PENDING)
  description String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bet {
  id           Int        @id @default(autoincrement())
  userId       Int
  matchId      Int
  currency     Currency
  stake        Decimal     @db.Decimal(12,2)
  odds         Decimal     @db.Decimal(5,2)
  potentialWin Decimal     @db.Decimal(12,2)
  status       BetStatus
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  match        Match       @relation(fields: [matchId], references: [id])
}

model Match {
  id        Int     @id @default(autoincrement())
  name      String
  startTime DateTime
  endTime   DateTime?
  bets      Bet[]
}



