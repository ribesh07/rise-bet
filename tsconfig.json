{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
"incremental": true,
"plugins": [
  {
    "name": "next"
  },
  {
    "name": "tailwind-scrollbar-hide"
  }
],
"paths": {
  "@/*": ["./*"]
}
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.js",
    "components/**/*.ts",
    "components/**/*.tsx",
    "components/**/*.js",
    "context/**/*.ts",
    "context/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "store/**/*.ts",
    "store/**/*.tsx",
    "types/**/*.ts",
    "utils/**/*.ts",
    "utils/**/*.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "admin"]
  
}
